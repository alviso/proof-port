@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'ZCRED limit threshold per currency'
@UI.headerInfo: { typeName: 'Limit rule', typeNamePlural: 'Limit rules' }
define view entity ZPP_CR_C_LIMITRULE
  as select from zcr_limit_rule
{
      @UI.lineItem: [ { position: 10, label: 'Currency' } ]
  key waers     as Currency,

      @Semantics.amount.currencyCode: 'Currency'
      @UI.lineItem: [ { position: 20, label: 'Reason needed above' } ]
      threshold as Threshold
}
